  "native_decide": [
   {
    "axiom": "FKS2Scalar.sum1_checks._native.native_decide.ax_1_1",
    "theorem": "FKS2Scalar.sum1_checks",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_scalar_fp/lean/FKS2Scalar/Enclosure.lean",
    "line": 31,
    "proposition": "∀ k ∈ Finset.Icc 3 43,\n  FKS2Scalar.expCheck (FKS2Scalar.x1 k) (FKS2Scalar.expLo (FKS2Scalar.x1 k)) (FKS2Scalar.expHi (FKS2Scalar.x1 k)) = true"
   },
   {
    "axiom": "FKS2Scalar.sum2_checks._native.native_decide.ax_1_1",
    "theorem": "FKS2Scalar.sum2_checks",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_scalar_fp/lean/FKS2Scalar/Enclosure.lean",
    "line": 36,
    "proposition": "∀ k ∈ Finset.Icc 3 44,\n  FKS2Scalar.expCheck (FKS2Scalar.x2lo k) (FKS2Scalar.expLo (FKS2Scalar.x2lo k))\n        (FKS2Scalar.expHi (FKS2Scalar.x2lo k)) =\n      true ∧\n    FKS2Scalar.expCheck (FKS2Scalar.x2hi k) (FKS2Scalar.expLo (FKS2Scalar.x2hi k))\n        (FKS2Scalar.expHi (FKS2Scalar.x2hi k)) =\n      true"
   },
   {
    "axiom": "FKS2Scalar.z_exp_checks._native.native_decide.ax_1_1",
    "theorem": "FKS2Scalar.z_exp_checks",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_scalar_fp/lean/FKS2Scalar/Enclosure.lean",
    "line": 96,
    "proposition": "FKS2Scalar.expCheck (2 * FKS2Scalar.zLo) (FKS2Scalar.expLo (2 * FKS2Scalar.zLo))\n      (FKS2Scalar.expHi (2 * FKS2Scalar.zLo)) =\n    true ∧\n  FKS2Scalar.expCheck (2 * FKS2Scalar.zHi) (FKS2Scalar.expLo (2 * FKS2Scalar.zHi))\n        (FKS2Scalar.expHi (2 * FKS2Scalar.zHi)) =\n      true ∧\n    FKS2Scalar.expCheck (-15) (FKS2Scalar.expLo (-15)) (FKS2Scalar.expHi (-15)) = true ∧\n      FKS2Scalar.expCheck (-20) (FKS2Scalar.expLo (-20)) (FKS2Scalar.expHi (-20)) = true"
   },
   {
    "axiom": "FKS2Scalar.target_enclosure._native.native_decide.ax_1_1",
    "theorem": "FKS2Scalar.target_enclosure",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_scalar_fp/lean/FKS2Scalar/Enclosure.lean",
    "line": 113,
    "proposition": "0 ≤ FKS2Scalar.uLo ∧\n  0 ≤ FKS2Scalar.expLo (2 * FKS2Scalar.zLo) ∧\n    0 ≤ FKS2Scalar.expLo (-15) ∧ 0 ≤ FKS2Scalar.expLo (-20) ∧ 0 ≤ FKS2Scalar.s1lo ∧ 0 ≤ FKS2Scalar.s2lo"
   },
   {
    "axiom": "FKS2SumBridge.extracted_sum_indexing._native.native_decide.ax_1_1",
    "theorem": "FKS2SumBridge.extracted_sum_indexing",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_sum_bridge/lean/FKS2SumBridge/Analysis.lean",
    "line": 28,
    "proposition": "FKS2SumBridge.terms1.sum = ∑ k ∈ Finset.Icc 3 43, FKS2SumBridge.term1 k ∧\n  FKS2SumBridge.terms2.sum = ∑ k ∈ Finset.Icc 3 44, FKS2SumBridge.term2 k"
   },
   {
    "axiom": "FKS2SumBridge.concrete_trace_checks._native.native_decide.ax_1_1",
    "theorem": "FKS2SumBridge.concrete_trace_checks",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_sum_bridge/lean/FKS2SumBridge/Instances.lean",
    "line": 93,
    "proposition": "FKS2SumBridge.trace1.steps.length = 41 ∧\n  FKS2SumBridge.trace2.steps.length = 42 ∧\n    (List.map FKS2SumBridge.counterOf FKS2SumBridge.trace1.steps = do\n        let a ← List.map (fun j => j + 3) (List.range 41)\n        pure ↑a) ∧\n      (List.map FKS2SumBridge.counterOf FKS2SumBridge.trace2.steps = do\n          let a ← List.map (fun j => j + 3) (List.range 42)\n          pure ↑a) ∧\n        (∀ step ∈ FKS2SumBridge.trace1.steps,\n            FKS2SumBridge.stepCheck \"s1\" step = true ∧ FKS2SumBridge.inputCheck (FKS2SumBridge.termOf step) = true) ∧\n          (∀ step ∈ FKS2SumBridge.trace2.steps,\n              FKS2SumBridge.stepCheck \"s2\" step = true ∧ FKS2SumBridge.inputCheck (FKS2SumBridge.termOf step) = true) ∧\n            FKS2SumBridge.chainCheck \"s1\" FKS2SumBridge.trace1.steps 0 FKS2SumBridge.acc1 = true ∧\n              FKS2SumBridge.chainCheck \"s2\" FKS2SumBridge.trace2.steps 0 FKS2SumBridge.acc2 = true ∧\n                FKS2Scalar.get FKS2SumBridge.fullFrame.env \"s1\" = some FKS2SumBridge.acc1 ∧\n                  FKS2Scalar.get FKS2SumBridge.fullFrame.env \"s2\" = some FKS2SumBridge.acc2"
   },
   {
    "axiom": "FKS2SumBridge.integration_budget_checks._native.native_decide.ax_1_1",
    "theorem": "FKS2SumBridge.integration_budget_checks",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_sum_bridge/lean/FKS2SumBridge/Integration.lean",
    "line": 42,
    "proposition": "0 ≤ FKS2SumBridge.specError1 ∧\n  0 ≤ FKS2SumBridge.specError2 ∧\n    0 ≤ FKS2SumBridge.bridgeError ∧\n      FKS2SumBridge.bridgeError ≤ 1 / 10 ^ 15 ∧ FKS2Scalar.q + FKS2SumBridge.bridgeError ≤ FKS2Scalar.Bpoc"
   },
   {
    "axiom": "FKS2SumBridge.composition_checks._native.native_decide.ax_1_1",
    "theorem": "FKS2SumBridge.composition_checks",
    "file": "Solutions/FKS2Numerics.v2/applications/fks2_sum_bridge/lean/FKS2SumBridge/Whole.lean",
    "line": 36,
    "proposition": "0 < FKS2SumBridge.prefactor ∧\n  0 < FKS2SumBridge.sumCoefficient ∧\n    |FKS2Scalar.q - FKS2SumBridge.hybridRat FKS2SumBridge.acc1 FKS2SumBridge.acc2| ≤ FKS2SumBridge.suffixError ∧\n      FKS2SumBridge.comparisonHi - FKS2SumBridge.comparisonLo ≤ FKS2SumBridge.coefficientError ∧\n        0 ≤ FKS2SumBridge.sumError1 ∧\n          0 ≤ FKS2SumBridge.sumError2 ∧\n            0 ≤ FKS2SumBridge.totalError ∧\n              FKS2SumBridge.totalError ≤ 1 / 10 ^ 15 ∧ FKS2Scalar.q + FKS2SumBridge.totalError ≤ FKS2Scalar.Bpoc"
   }
