   },
   {
    "axiom": "ForwardRamanujan.Updated.execution_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Updated.execution_check",
    "file": "Solutions/RamanujanNumerics.v2/ForwardRamanujanUpdate/Updated.lean",
    "line": 50,
    "proposition": "List.mapM ForwardRamanujan.loadLiteral ForwardRamanujan.Updated.program.inputs = some ForwardRamanujan.Updated.data ∧\n  (ForwardRamanujan.Updated.initial.buffer = ForwardRamanujan.Updated.data ∧\n      ForwardRamanujan.Updated.initial.extent = ForwardRamanujan.Updated.data.length ∧\n        ForwardRamanujan.Updated.initial.n = ForwardRamanujan.Updated.data.length ∧\n          ForwardRamanujan.Updated.initial.base % 8 = 0 ∧\n            ForwardRamanujan.Updated.initial.base + 8 * ForwardRamanujan.Updated.initial.extent < 2 ^ 64 ∧\n              0 < ForwardRamanujan.Updated.initial.base) ∧\n    ForwardRamanujan.runSum ForwardRamanujan.Updated.data 0 = some ForwardRamanujan.Updated.sumOut ∧\n      ForwardRamanujan.chainCheck ForwardRamanujan.Updated.data 0 ForwardRamanujan.Updated.sumOut = true ∧\n        ForwardRamanujan.suffix ForwardRamanujan.Updated.program ForwardRamanujan.Updated.sumOut =\n            some ForwardRamanujan.Updated.out ∧\n          FKS2Scalar.finiteBits ForwardRamanujan.Updated.outputBits = true ∧\n            FKS2Scalar.encodePositiveNormal ForwardRamanujan.Updated.out = some ForwardRamanujan.Updated.outputBits"
   },
   {
    "axiom": "ForwardRamanujan.Updated.suffix_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Updated.suffix_check",
    "file": "Solutions/RamanujanNumerics.v2/ForwardRamanujanUpdate/Updated.lean",
    "line": 60,
    "proposition": "ForwardRamanujan.loadLiteral ForwardRamanujan.Updated.program.scale = some ForwardRamanujan.Updated.scale ∧\n  ForwardRamanujan.loadLiteral ForwardRamanujan.Updated.program.fixedOffset =\n      some ForwardRamanujan.Updated.fixedOffset ∧\n    ForwardRamanujan.loadLiteral ForwardRamanujan.Updated.program.positiveOffset =\n        some ForwardRamanujan.Updated.positiveOffset ∧\n      FKS2Table4.additionCheck (ForwardRamanujan.Updated.sumOut * ForwardRamanujan.Updated.scale)\n            ForwardRamanujan.Updated.r0 =\n          true ∧\n        FKS2Table4.additionCheck (ForwardRamanujan.Updated.r0 - ForwardRamanujan.Updated.fixedOffset)\n              ForwardRamanujan.Updated.r1 =\n            true ∧\n          FKS2Table4.additionCheck (ForwardRamanujan.Updated.r1 - ForwardRamanujan.Updated.positiveOffset)\n                ForwardRamanujan.Updated.out =\n              true ∧\n            ForwardRamanujan.Updated.r0 = ForwardRamanujan.Updated.scale * ForwardRamanujan.Updated.sumOut ∧\n              |ForwardRamanujan.Updated.r1 - (ForwardRamanujan.Updated.r0 - ForwardRamanujan.Updated.fixedOffset)| ≤\n                  1 / 10 ^ 11 ∧\n                |ForwardRamanujan.Updated.out -\n                      (ForwardRamanujan.Updated.r1 - ForwardRamanujan.Updated.positiveOffset)| ≤\n                  1 / 10 ^ 11"
   },
   {
