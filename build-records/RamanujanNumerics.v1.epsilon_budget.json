   {
    "axiom": "ForwardRamanujan.Old.enclosure_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Old.enclosure_check",
    "file": "Solutions/RamanujanNumerics.v1/ForwardRamanujan/Old.lean",
    "line": 41,
    "proposition": "ForwardRamanujan.Old.data.length = 7 ∧\n  ForwardRamanujan.Old.targets.length = 7 ∧\n    (∀ j ∈ Finset.range 7,\n        [2852, 2984 / 3915, 5992 / 15327225, 5896 / 20002028625, 22816 / 78307942066875, 2033476 / 919726779575446875,\n                2149636014196611085828125 / 1797607752008961505568][j]! /\n            4096 ≤\n          ForwardRamanujan.Old.data[j]!) ∧\n      (∀ j ∈ Finset.range 7,\n          if\n              [2852, 2984 / 3915, 5992 / 15327225, 5896 / 20002028625, 22816 / 78307942066875,\n                      2033476 / 919726779575446875, 2149636014196611085828125 / 1797607752008961505568][j]! /\n                  4096 <\n                1 / 2 ^ 40 then\n            ForwardRamanujan.Old.data[j]! = 1 / 2 ^ 40\n          else True) ∧\n        ForwardRamanujan.Old.targets.sum ≤ ForwardRamanujan.Old.scale * ForwardRamanujan.Old.data.sum"
   },
   {
    "axiom": "ForwardRamanujan.Old.domain_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Old.domain_check",
    "file": "Solutions/RamanujanNumerics.v1/ForwardRamanujan/Old.lean",
    "line": 43,
    "proposition": "∀ r ∈ ForwardRamanujan.Old.data, FKS2SumBridge.inputCheck r = true"
   },
   {
    "axiom": "ForwardRamanujan.Old.execution_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Old.execution_check",
    "file": "Solutions/RamanujanNumerics.v1/ForwardRamanujan/Old.lean",
    "line": 50,
    "proposition": "List.mapM ForwardRamanujan.loadLiteral ForwardRamanujan.Old.program.inputs = some ForwardRamanujan.Old.data ∧\n  (ForwardRamanujan.Old.initial.buffer = ForwardRamanujan.Old.data ∧\n      ForwardRamanujan.Old.initial.extent = ForwardRamanujan.Old.data.length ∧\n        ForwardRamanujan.Old.initial.n = ForwardRamanujan.Old.data.length ∧\n          ForwardRamanujan.Old.initial.base % 8 = 0 ∧\n            ForwardRamanujan.Old.initial.base + 8 * ForwardRamanujan.Old.initial.extent < 2 ^ 64 ∧\n              0 < ForwardRamanujan.Old.initial.base) ∧\n    ForwardRamanujan.runSum ForwardRamanujan.Old.data 0 = some ForwardRamanujan.Old.sumOut ∧\n      ForwardRamanujan.chainCheck ForwardRamanujan.Old.data 0 ForwardRamanujan.Old.sumOut = true ∧\n        ForwardRamanujan.suffix ForwardRamanujan.Old.program ForwardRamanujan.Old.sumOut =\n            some ForwardRamanujan.Old.out ∧\n          FKS2Scalar.finiteBits ForwardRamanujan.Old.outputBits = true ∧\n            FKS2Scalar.encodePositiveNormal ForwardRamanujan.Old.out = some ForwardRamanujan.Old.outputBits"
   },
   {
    "axiom": "ForwardRamanujan.Old.suffix_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Old.suffix_check",
    "file": "Solutions/RamanujanNumerics.v1/ForwardRamanujan/Old.lean",
    "line": 60,
    "proposition": "ForwardRamanujan.loadLiteral ForwardRamanujan.Old.program.scale = some ForwardRamanujan.Old.scale ∧\n  ForwardRamanujan.loadLiteral ForwardRamanujan.Old.program.fixedOffset = some ForwardRamanujan.Old.fixedOffset ∧\n    ForwardRamanujan.loadLiteral ForwardRamanujan.Old.program.positiveOffset =\n        some ForwardRamanujan.Old.positiveOffset ∧\n      FKS2Table4.additionCheck (ForwardRamanujan.Old.sumOut * ForwardRamanujan.Old.scale) ForwardRamanujan.Old.r0 =\n          true ∧\n        FKS2Table4.additionCheck (ForwardRamanujan.Old.r0 - ForwardRamanujan.Old.fixedOffset) ForwardRamanujan.Old.r1 =\n            true ∧\n          FKS2Table4.additionCheck (ForwardRamanujan.Old.r1 - ForwardRamanujan.Old.positiveOffset)\n                ForwardRamanujan.Old.out =\n              true ∧\n            ForwardRamanujan.Old.r0 = ForwardRamanujan.Old.scale * ForwardRamanujan.Old.sumOut ∧\n              |ForwardRamanujan.Old.r1 - (ForwardRamanujan.Old.r0 - ForwardRamanujan.Old.fixedOffset)| ≤ 1 / 10 ^ 11 ∧\n                |ForwardRamanujan.Old.out - (ForwardRamanujan.Old.r1 - ForwardRamanujan.Old.positiveOffset)| ≤\n                  1 / 10 ^ 11"
   },
   {
    "axiom": "ForwardRamanujan.Old.budget_check._native.native_decide.ax_1_1",
    "theorem": "ForwardRamanujan.Old.budget_check",
    "file": "Solutions/RamanujanNumerics.v1/ForwardRamanujan/Old.lean",
    "line": 65,
    "proposition": "(List.map abs ForwardRamanujan.Old.data).sum = ForwardRamanujan.Old.data.sum ∧\n  0 ≤ SumStability.gamma (ForwardRamanujan.Old.data.length - 1) ∧\n    SumStability.gamma (ForwardRamanujan.Old.data.length - 1) < 1 ∧\n      0 ≤ ForwardRamanujan.Old.scale ∧\n        0 ≤ ForwardRamanujan.Old.totalError ∧\n          ForwardRamanujan.Old.totalError ≤ 1 / 10 ^ 8 ∧\n            ForwardRamanujan.Old.out + ForwardRamanujan.Old.totalError ≤ ForwardRamanujan.Old.bound"
   }
  ],
