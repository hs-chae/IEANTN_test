+import IEANTN.Vocabulary.PrimeCounting
+import Mathlib.Analysis.SpecialFunctions.Log.Basic
+
+/-!
+# Node `PVMatchShrD.v1` (HYPOTHETICAL)
+
+Disposable experiment for the PV node-split study (matched A/B layouts).
+Local branch only; never pushed.
+-/
+
+namespace PVMatchShrD.v1
+open Real IEANTN
+
+/-- Layout A of matched experiment M3 (shared result), consumer 2: the statement of `DudekPlatt.v5.ramanujan_401`,
+with `DudekPlattNumerics.v5`'s π expansion proved inside the solution instead of imported. -/
+def ramanujan_401 : Prop :=
+  ∀ x : ℝ, exp 401 < x →
+  primeCounting x ^ 2 < exp 1 * x / log x * primeCounting (x / exp 1)
+
+end PVMatchShrD.v1
