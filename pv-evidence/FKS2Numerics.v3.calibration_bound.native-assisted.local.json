    "decided_proposition": "FKS2SumBridge.trace1.steps.length = 41 ∧\n  FKS2SumBridge.trace2.steps.length = 42 ∧\n    (List.map FKS2SumBridge.counterOf FKS2SumBridge.trace1.steps = do\n        let a ← List.map (fun j => j + 3) (List.range 41)\n        pure ↑a) ∧\n      (List.map FKS2SumBridge.counterOf FKS2SumBridge.trace2.steps = do\n          let a ← List.map (fun j => j + 3) (List.range 42)\n          pure ↑a) ∧\n        (∀ step ∈ FKS2SumBridge.trace1.steps,\n            FKS2SumBridge.stepCheck \"s1\" step = true ∧ FKS2SumBridge.inputCheck (FKS2SumBridge.termOf step) = true) ∧\n          (∀ step ∈ FKS2SumBridge.trace2.steps,\n              FKS2SumBridge.stepCheck \"s2\" step = true ∧ FKS2SumBridge.inputCheck (FKS2SumBridge.termOf step) = true) ∧\n            FKS2SumBridge.chainCheck \"s1\" FKS2SumBridge.trace1.steps 0 FKS2SumBridge.acc1 = true ∧\n              FKS2SumBridge.chainCheck \"s2\" FKS2SumBridge.trace2.steps 0 FKS2SumBridge.acc2 = true ∧\n                FKS2Scalar.get FKS2SumBridge.fullFrame.env \"s1\" = some FKS2SumBridge.acc1 ∧\n                  FKS2Scalar.get FKS2SumBridge.fullFrame.env \"s2\" = some FKS2SumBridge.acc2",
