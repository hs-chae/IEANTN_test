ACTUAL_TYPE CubeStudy.buthe_cube_pointwise: CubeStudy.Buthe →
  ∀ {n : ℝ},
    12 ≤ n →
      1 ≤ Real.log n →
        (n + 1) ^ 3 ≤ 10 ^ 19 →
          (1 - CubeStudy.butheLoss n) * (n ^ 2 / Real.log n) < CubeStudy.count (n ^ 3) ((n + 1) ^ 3)
