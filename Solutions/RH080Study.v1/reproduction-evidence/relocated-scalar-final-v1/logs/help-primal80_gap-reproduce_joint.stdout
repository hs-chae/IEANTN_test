usage: reproduce_joint.py [-h] --out OUT [--context CONTEXT]
                          [--lean-cert-source LEAN_CERT_SOURCE]
                          [--workers {1,2,3,4,5,6,7,8}]
                          [--worker-memory-gib {32,64}]
                          [--reuse-cold-leaves REUSE_COLD_LEAVES]
                          [--accepted-new-cell-bank ACCEPTED_NEW_CELL_BANK]

options:
  -h, --help            show this help message and exit
  --out OUT
  --context CONTEXT
  --lean-cert-source LEAN_CERT_SOURCE
  --workers {1,2,3,4,5,6,7,8}
  --worker-memory-gib {32,64}
  --reuse-cold-leaves REUSE_COLD_LEAVES
  --accepted-new-cell-bank ACCEPTED_NEW_CELL_BANK
