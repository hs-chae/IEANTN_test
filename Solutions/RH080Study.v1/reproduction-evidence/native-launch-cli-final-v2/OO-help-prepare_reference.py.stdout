usage: prepare_reference.py [-h] [--repository REPOSITORY] --template
                            {primary,followup-V0,followup-V1} --root ROOT
                            --toolchain TOOLCHAIN --packages PACKAGES
                            --generic-source-root GENERIC_SOURCE_ROOT --corpus
                            CORPUS --representation REPRESENTATION
                            [--support SUPPORT]

options:
