                  (Mathlib.Tactic.Linarith.sub_nonpos_of_le hx))
                (Mathlib.Tactic.Linarith.sub_neg_of_lt a))))
        hxQ hε)
  else
    Eq.mpr
      (id
        (congrArg Exists
          (funext fun q =>
