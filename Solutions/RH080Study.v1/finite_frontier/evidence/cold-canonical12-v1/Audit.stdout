RH080.FiniteFrontier.strict_minimum_width (hgap : PrimeGapTable.v1.gaps)
  (hsource : RH080.FiniteFrontier.SourceLogSquaredGap) {x ε : ℝ} (hx : 11 ≤ x) (hx42 : x ≤ Real.exp 42) (hε : 0 < ε) :
  ∃ q, Nat.Prime q ∧ x < ↑q ∧ ↑q < x + min (1550 + ε) (Real.log x ^ 2)
