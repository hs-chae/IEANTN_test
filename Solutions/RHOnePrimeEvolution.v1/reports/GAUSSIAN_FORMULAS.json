{
  "GF_functions": "\\begin{gathered}P,Q\\in\\mathbb Q[u],\\qquad\\deg P=\\deg Q=24,\\qquad P(-u)=P(u),\\quad Q(-u)=Q(u),\\\\F(x):=P(\\sqrt\\pi\\,x)e^{-\\pi x^2},\\qquad G(\\xi):=Q(\\sqrt\\pi\\,\\xi)e^{-\\pi\\xi^2},\\\\\\widehat F(\\xi):=\\int_{\\mathbb R}F(x)e^{-2\\pi i x\\xi}\\,dx=G(\\xi).\\end{gathered}",
  "GF_prime_objects": "\\begin{gathered}f(x):=\\sqrt x\\log x\\quad(x>1),\\qquad\\mathbb P:=\\{p\\in\\mathbb N:\\operatorname{Prime}(p)\\},\\\\\\pi(x):=\\#\\{p\\in\\mathbb P:p\\le x\\},\\qquad p_n:=\\operatorname{Nat.nth}(\\operatorname{Prime},n),\\\\p_0=2,\\qquad p_1=3,\\qquad p_2=5.\\end{gathered}",
  "GF_population_objects": "c>0,\\quad x>1:\\qquad\\Pi(c,x):=\\pi(x+cf(x))-\\pi(x)=\\#\\{p\\in\\mathbb P:x<p\\le x+cf(x)\\}.",
  "GF_gap": "\\begin{gathered}\\mathrm{RH}\\land\\mathcal B_{\\rm gap}\\quad\\Longrightarrow\\\\\\forall\\varepsilon>0\\ \\exists n_0\\in\\mathbb N\\ \\forall n\\ge n_0,\\qquad\\frac{p_{n+1}-p_n}{f(p_n)}\\le0.834021+\\varepsilon.\\end{gathered}",
  "GF_gap_strict": "\\mathrm{RH}\\land\\mathcal B_{\\rm gap}\\quad\\Longrightarrow\\quad\\exists n_1\\in\\mathbb N\\ \\forall n\\ge n_1,\\qquad\\frac{p_{n+1}-p_n}{f(p_n)}<0.834050619151.",
  "GF_published_gap": "\\mathrm{RH}\\quad\\Longrightarrow\\quad\\limsup_{n\\to\\infty}\\frac{p_{n+1}-p_n}{\\sqrt{p_n}\\log p_n}\\le0.834050619151<0.834051.",
  "GF_integral_definitions": "\\begin{gathered}M:=\\|F\\|_1=\\int_{\\mathbb R}|F(x)|\\,dx,\\qquad J:=\\int_{|\\xi|>1}\\max\\{G(\\xi),0\\}\\,d\\xi,\\\\A:=\\frac{36}{11},\\qquad D:=F(0)-AJ,\\qquad R_A(F):=\\frac MD.\\end{gathered}",
  "GF_integral_bounds": "M\\le\\frac{74899}{100000}=0.74899,\\qquad J\\le\\frac{31152}{1000000}=0.031152,\\qquad F(0)\\ge\\frac{999999999}{1000000000}=0.999999999.",
  "GF_denominator_steps": "\\begin{aligned}D&\\ge0.999999999-\\frac{36}{11}\\,0.031152>0,\\\\R_{36/11}(F)&\\le\\frac{0.74899}{0.999999999-(36/11)\\,0.031152}\\\\&\\le0.834021<0.834050619151.\\end{aligned}",
  "GF_fourier_recurrence": "\\begin{gathered}\\mathcal P:=\\{R\\in\\mathbb Q[u]:R(-u)=R(u)\\},\\qquad\\mathscr T:\\mathcal P\\to\\mathcal P,\\\\\\mathscr T(1)=1,\\qquad\\mathscr T(aR+bS)=a\\mathscr T(R)+b\\mathscr T(S)\\quad(a,b\\in\\mathbb Q;\\ R,S\\in\\mathcal P),\\\\(\\mathcal E S)(u):=-\\frac14S^{\\prime\\prime}(u)+uS^{\\prime}(u)+\\left(\\frac12-u^2\\right)S(u),\\\\\\mathscr T(u^2R)=\\mathcal E(\\mathscr T(R)),\\qquad\\mathscr T(P)=Q,\\\\\\widehat{\\bigl(x\\mapsto R(\\sqrt\\pi\\,x)e^{-\\pi x^2}\\bigr)}(\\xi)=(\\mathscr T(R))(\\sqrt\\pi\\,\\xi)e^{-\\pi\\xi^2}.\\end{gathered}",
  "GF_cell_taylor": "\\begin{gathered}u=a+ht,\\quad a,h\\ge0,\\quad0\\le t\\le1,\\qquad d:=u^2-a^2,\\quad0\\le d\\le\\Delta:=2ah+h^2,\\\\\\left|e^{-d}-\\sum_{k=0}^{7}\\frac{(-d)^k}{k!}\\right|\\le\\frac{\\Delta^8}{8!}.\\end{gathered}",
  "GF_polynomial_integral": "\\int_0^1\\left(\\sum_{k=0}^{m}b_kt^k\\right)dt=\\sum_{k=0}^{m}\\frac{b_k}{k+1},\\qquad b_k\\in\\mathbb Q.",
  "GF_tail": "\\begin{gathered}u\\ge8,\\quad k\\in\\{0,\\ldots,24\\}:\\qquad u^ke^{-u^2}\\le8^ke^{-60}e^{-u^2/16},\\\\R(u)=\\sum_{k=0}^{24}r_ku^k\\quad\\Longrightarrow\\quad\\int_8^\\infty|R(u)|e^{-u^2}\\,du\\le8e^{-60}\\sum_{k=0}^{24}|r_k|8^k.\\end{gathered}",
  "GF_raw_scaling": "\\begin{gathered}\\int_0^\\infty|P(u)|e^{-u^2}\\,du\\le0.66377000001,\\\\a_*:=1.77245\\le\\sqrt\\pi,\\qquad\\int_{a_*}^{\\infty}\\max\\{Q(u),0\\}e^{-u^2}\\,du\\le0.02760730001,\\\\\\frac{2}{\\sqrt\\pi}\\le1.12838,\\qquad M=\\frac2{\\sqrt\\pi}\\int_0^\\infty|P(u)|e^{-u^2}\\,du,\\\\J=\\frac2{\\sqrt\\pi}\\int_{\\sqrt\\pi}^{\\infty}\\max\\{Q(u),0\\}e^{-u^2}\\,du.\\end{gathered}",
  "GF_CMS_extremal": "\\begin{gathered}\\mathcal A^+:=\\{H\\in C(\\mathbb R;\\mathbb R)\\cap L^1(\\mathbb R):H(-u)=H(u)\\ \\forall u\\in\\mathbb R\\},\\\\1\\le A<\\infty,\\qquad C^+(A):=\\sup_{\\substack{H\\in\\mathcal A^+\\\\H\\ne0}}\\frac{H(0)-A\\int_{|t|>1}\\max\\{\\widehat H(t),0\\}\\,dt}{\\|H\\|_1}.\\end{gathered}",
  "GF_CMS_B": "B:=\\limsup_{x\\to\\infty}\\frac{\\pi(x+\\sqrt x)-\\pi(x)}{\\sqrt x/\\log x},\\qquad1\\le B\\le\\frac{36}{11}.",
  "GF_CMS_conclusions": "\\begin{gathered}C_{\\rm pop}(\\alpha):=\\inf\\left\\{c>0:\\liminf_{x\\to\\infty}\\frac{\\Pi(c,x)}{\\sqrt x}>\\alpha\\right\\},\\\\\\mathrm{RH}\\quad\\Longrightarrow\\quad C_{\\rm pop}(\\alpha)\\le\\frac{1+2\\alpha}{C^+(B)}\\quad(\\alpha\\ge0),\\\\\\mathrm{RH}\\quad\\Longrightarrow\\quad\\limsup_{n\\to\\infty}\\frac{p_{n+1}-p_n}{f(p_n)}\\le\\frac1{C^+(B)}.\\end{gathered}",
  "GF_source_allowance": "\\begin{aligned}J&\\ge0,\\quad B\\le A=36/11,\\quad M>0,\\quad D>0,\\\\F(0)-BJ&\\ge F(0)-AJ=D,\\\\C^+(B)&\\ge\\frac{F(0)-BJ}{M}\\ge\\frac DM>0,\\\\\\frac1{C^+(B)}&\\le\\frac MD\\le0.834021.\\end{aligned}",
  "GF_population_curve": "\\begin{gathered}\\mathrm{RH}\\land\\mathcal B_{\\rm pop},\\quad\\alpha\\ge0,\\quad\\varepsilon>0,\\qquad c:=0.834021(1+2\\alpha)+\\varepsilon,\\\\\\Longrightarrow\\quad\\exists\\delta>0\\ \\exists X\\in\\mathbb R\\ \\forall x\\ge X,\\qquad\\alpha+\\delta\\le\\frac{\\Pi(c,x)}{\\sqrt x}.\\end{gathered}",
  "GF_population_count": "\\mathrm{RH}\\land\\mathcal B_{\\rm pop}\\quad\\Longrightarrow\\quad\\forall\\alpha\\ge0\\ \\forall\\varepsilon>0\\ \\exists X\\ \\forall x\\ge X,\\qquad\\Pi\\!\\left(0.834021(1+2\\alpha)+\\varepsilon,x\\right)>\\alpha\\sqrt x.",
  "GF_population_old_comparison": "\\begin{gathered}\\inf\\!\\left\\{c>0:\\liminf_{x\\to\\infty}\\frac{\\Pi(c,x)}{\\sqrt x}>\\alpha\\right\\}<0.8358(1+2\\alpha),\\qquad\\alpha\\ge0,\\\\0.834021(1+2\\alpha)<0.8358(1+2\\alpha),\\qquad\\alpha\\ge0.\\end{gathered}",
  "GF_population_2026": "\\begin{gathered}\\inf\\!\\left\\{c>0:\\liminf_{x\\to\\infty}\\frac{\\Pi(c,x)}{\\sqrt x}>\\alpha\\right\\}\\\\<\\min\\!\\left\\{0.851127043+1.505827\\alpha,\\quad0.85124642+1.505237\\alpha\\right\\},\\qquad\\alpha\\ge0.\\end{gathered}",
  "GF_evidence_status": "\\begin{array}{c|c|c}d&R_{36/11}(F)&\\mathcal V\\\\\\hline12&\\le0.834021&\\mathrm D\\\\12&\\approx0.834009631&\\mathrm E\\\\40&\\le0.833948868&\\mathrm E\\end{array}",
  "GF_typed_edges": "\\begin{gathered}\\mathsf{integral\\_fourier\\_witness}\\Longrightarrow\\mathsf{objective\\_witness},\\\\\\mathsf{objective\\_witness}\\land\\mathrm{RH}\\land\\mathcal B_{\\rm gap}\\\\\\Longrightarrow\\mathsf{normalized\\_gap}\\Longrightarrow\\mathsf{gap\\_below\\_printed\\_2026},\\\\\\mathsf{objective\\_witness}\\land\\mathrm{RH}\\land\\mathcal B_{\\rm pop}\\\\\\Longrightarrow\\mathsf{population\\_curve}\\Longrightarrow\\mathsf{population\\_count}.\\end{gathered}",
  "GF_input_names": "\\begin{gathered}\\mathcal B_{\\rm gap}:=\\mathsf{CMSFunctionalInput.v1.gap\\_reduction},\\\\\\mathcal B_{\\rm pop}:=\\mathsf{CMSFunctionalInput.v1.population\\_reduction}.\\end{gathered}",
  "GF_finite_and_tail": "\\begin{gathered}\\int_0^8|P(u)|e^{-u^2}\\,du\\le0.66377,\\qquad\\int_{a_*}^8\\max\\{Q(u),0\\}e^{-u^2}\\,du\\le0.0276073,\\\\\\int_8^\\infty|P(u)|e^{-u^2}\\,du\\le10^{-11},\\qquad\\int_8^\\infty\\max\\{Q(u),0\\}e^{-u^2}\\,du\\le10^{-11},\\\\0.66377+10^{-11}=0.66377000001,\\qquad0.0276073+10^{-11}=0.02760730001.\\end{gathered}"
}
