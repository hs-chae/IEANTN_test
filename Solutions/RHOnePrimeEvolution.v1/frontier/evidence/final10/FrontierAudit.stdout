RHOnePrime.Frontier.count_frontier : RHOcticPush.GreenSource.SourceGreenSmooth →
  NicolasContinuation.SourceNicolas119 →
    RHOcticPush.BPTSourceEndpoint.SourceBPTOffOrdinate →
      RiemannHypothesis →
        ∀ {α ε : ℝ},
          RHOnePrime.Frontier.widthFor (α + ε) ∈ Set.Icc (103 / 100) 16 →
            ∀ {x : ℝ},
              Real.exp 24 ≤ x →
                (α + ε + 21 / 5 / Real.log x) * √x <
                  ↑(QuarticWindow.primesBetween x (x + RHOnePrime.Frontier.widthFor (α + ε) * √x * Real.log x)).card
@RHOnePrime.Frontier.quantile_open_of_card : ∀ {x y : ℝ},
  0 ≤ x →
    ∀ {m : ℕ},
      ↑m < ↑(QuarticWindow.primesBetween x y).card →
        x < ↑(Nat.nth Nat.Prime (⌊x⌋₊.primeCounting + m)) ∧ ↑(Nat.nth Nat.Prime (⌊x⌋₊.primeCounting + m)) < y
RHOnePrime.Frontier.pointwise_index_frontier : RHOcticPush.GreenSource.SourceGreenSmooth →
  NicolasContinuation.SourceNicolas119 →
    RHOcticPush.BPTSourceEndpoint.SourceBPTOffOrdinate →
      RiemannHypothesis →
        ∀ {x : ℝ},
          Real.exp 24 ≤ x →
            ∀ (m : ℕ),
              RHOnePrime.Frontier.indexWidth m x ∈ Set.Icc (103 / 100) 16 →
                x < ↑(Nat.nth Nat.Prime (⌊x⌋₊.primeCounting + m)) ∧
                  ↑(Nat.nth Nat.Prime (⌊x⌋₊.primeCounting + m)) <
                    x + RHOnePrime.Frontier.indexWidth m x * √x * Real.log x
RHOnePrime.Goldbach.triples_extended_range : RHOcticPush.GreenSource.SourceGreenSmooth →
  NicolasContinuation.SourceNicolas119 →
    RHOcticPush.BPTSourceEndpoint.SourceBPTOffOrdinate →
      RiemannHypothesis →
        ∀ {H n : ℕ},
          IEANTN.GoldbachEvenUpTo H →
            Odd n →
              3 * H ≤ 2 * n →
                ∀ {C : ℝ},
                  C ∈ Set.Icc (103 / 100) 16 →
                    Real.exp 24 ≤ ↑n - ↑H →
                      C * √(↑n - ↑H) * Real.log (↑n - ↑H) ≤ ↑H - 4 →
                        RHOnePrime.Frontier.allowance C (↑n - ↑H) / 2 < ↑(RHOcticPush.Goldbach.sortedTriples n).card
RHOnePrime.Goldbach.triples_full_finite_range : RHOcticPush.GreenSource.SourceGreenSmooth →
  NicolasContinuation.SourceNicolas119 →
    RHOcticPush.BPTSourceEndpoint.SourceBPTOffOrdinate →
      RiemannHypothesis →
        ∀ {H n : ℕ},
          IEANTN.GoldbachEvenUpTo H →
            Odd n →
              ∀ {C : ℝ},
                C ∈ Set.Icc (103 / 100) 16 →
                  Real.exp 24 ≤ ↑n - ↑H →
                    C * √(↑n - ↑H) * Real.log (↑n - ↑H) ≤ ↑H - 4 →
                      RHOnePrime.Frontier.allowance C (↑n - ↑H) / 3 < ↑(RHOcticPush.Goldbach.sortedTriples n).card
RHOnePrime.Goldbach.triples_piecewise_frontier : RHOcticPush.GreenSource.SourceGreenSmooth →
  NicolasContinuation.SourceNicolas119 →
    RHOcticPush.BPTSourceEndpoint.SourceBPTOffOrdinate →
      RiemannHypothesis →
        ∀ {H n : ℕ},
          IEANTN.GoldbachEvenUpTo H →
            Odd n →
              ∀ {C : ℝ},
                C ∈ Set.Icc (103 / 100) 16 →
                  Real.exp 24 ≤ ↑n - ↑H →
                    C * √(↑n - ↑H) * Real.log (↑n - ↑H) ≤ ↑H - 4 →
                      RHOnePrime.Frontier.allowance C (↑n - ↑H) / ↑(RHOnePrime.Goldbach.multiplicityDivisor H n) <
                        ↑(RHOcticPush.Goldbach.sortedTriples n).card
