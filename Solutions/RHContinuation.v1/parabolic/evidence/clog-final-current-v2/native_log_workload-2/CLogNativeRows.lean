def checked : Bool := (List.range 129).all fun n=>decide (words[n]?.getD 0 = model n)
-- Inputs0/1 are not part of the source workload or the accepted real-log domain.
def requiredChecked : Bool := (List.range 129).all fun n=>
  if n<2 then true else decide (words[n]?.getD 0 = model n)
theorem requiredChecked_true : requiredChecked=true := by decide +kernel
theorem word_eq_model {n : Nat} (hn : 2<=n) (hN : n<=128) : words[n]?.getD 0=model n := by
  have h:=(List.all_eq_true.mp requiredChecked_true) n (List.mem_range.mpr (by omega))
  have hh : ¬ n<2 := by omega
  simpa only [hh,↓reduceIte,decide_eq_true_eq] using h
theorem source_execution_and_interval {n : Nat} (hn : 2<=n) (hN : n<=128) :
  RamanujanPV.FiniteLogUpperExecute.SourceExecution n (words[n]?.getD 0) ∧
  ((words[n]?.getD 0:Nat):ℝ)/2^40-1/2^30<=Real.log n ∧
  Real.log n<=((words[n]?.getD 0:Nat):ℝ)/2^40 := by
  rw [word_eq_model hn hN]
  have h:=all_required_source_intervals hn hN
  exact ⟨h.1,h.2.1,h.2.2⟩
#print axioms source_execution_and_interval
end CLogNativeRows
