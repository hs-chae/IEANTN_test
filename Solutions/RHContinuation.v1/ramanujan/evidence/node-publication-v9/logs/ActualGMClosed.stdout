actual_J_closed_GM : SharedRH.hypothesis →
  GM_Q_Theorem1_1 →
    Buthe.v1.theorem_2_psi →
      Buthe.v1.theorem_2_li_minus_riemann_pi →
        ∀ {x : ℝ},
          rexp 8 ≤ x →
            |riemannPrimeCounting x - li x - (Chebyshev.psi x - x) / log x| ≤ 14 + 1386 / 5000 * √x / log x ^ 2
