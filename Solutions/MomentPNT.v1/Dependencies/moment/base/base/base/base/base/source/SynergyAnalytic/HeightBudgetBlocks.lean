import SynergyAnalytic.HeightBudgetProgram
namespace SynergyAnalytic.HeightPoint
open ScopedNumerical ScopedNumerical.ProofBox SynergyBasis SynergyBasis.Positive
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def sumBudget : Nat → Nat → ProofBox → Option ProofBox
  | 0,_,acc => some acc
  | count+1,start,acc => do
    let v ← budgetCell start
    sumBudget count (start+1) (add acc v)
def blockWords : List Int := [374516539660860283998776312201571293,339480716744452677465289787702082513,306281567189709194852661967194203516,274911128255352045661535697955981579,245360203666380640254809951236888654,217618236495064462867015641248406579,191673163784142698316015844452357856,167511249234085811054701107787279769,145116889290012526733224218159813776,124472386638058554942155081238590985,105557683309238471315510396508666654,88350043066929500827307914305795430,72823669169734923431662210136164122,58949238384541436780235921560755672,46693324320858678039700393131725172,36017671106349881097030478266306023,26878259099075161571443864791312317,19224071911379328614268855137971141,12995416525125111621831726061399858,8121538925681403348148024996501030,4517049755135202320747651276311555,2076135290948876748458777903926424,661983981808565464252903197900593,82534121841333917539252617636387]
def blockCheck (b:Nat) : Bool := match sumBudget 32 (32*b) zero with
  | none => false
  | some value => match blockWords[b]? with
    | none => false
    | some cap => decide (value.hi ≤ cap)

theorem blockWordCount : blockWords.length=24 := by decide +kernel
end SynergyAnalytic.HeightPoint
