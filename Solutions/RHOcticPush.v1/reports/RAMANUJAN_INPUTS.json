        "source_excerpt": "def formula : Prop := ∃ C : ℂ, ∀ x : ℝ, 1<x →\n  Summable (zeroPrimitive x) ∧\n  (psi1 x:ℂ)=(x:ℂ)^2/2-(∑' r,zeroPrimitive x r)-\n    (x:ℂ)*(deriv riemannZeta 0/riemannZeta 0)+C-\n      ((∑' n : ℕ,trivialPrimitive n x):ℝ)\nend IntegratedPerron.v1"
      },
      "primary_locator": "Hildebrand ANT2013.01.07,Theorem5.18/(5.32),p166; absolutezero convergence(5.34),p167; ψ1definition(5.21),p156. Multiplicity corroboration GM1312.4465v4,Eq.(1.3a),p2.",
      "Blueprint_correspondence": "IntegratedPerron.v1.formula",
      "actual_normalized_input": {
        "file": "Solutions/RHOcticPush.v1/box/perron/BoxIntegratedDefs.lean",
        "declaration": "SourceIntegratedPsi",
        "physical_line": 28,
        "source_sha256": "ec0cf4b03ad7bc5864557643103ad7dac164e38c5a5b6ecd1160fc0bf80233bc",
        "source_excerpt": "def SourceIntegratedPsi : Prop := ∃ C : ℂ, ∀ x : ℝ, 1<x →\n  Summable (zeroPrimitive x) ∧\n  (psi1 x:ℂ)=(x:ℂ)^2/2-(∑' ρ,zeroPrimitive x ρ)-(x:ℂ)*(Real.log (2*Real.pi):ℂ)+C-\n    ((∑' n : ℕ,trivialPrimitive n x):ℝ)\nend RHOcticPush.BoxPerron"
      },
      "normalization_tex": "\\zeta^\\prime(0)/\\zeta(0)=\\log(2\\pi),\\quad\\int_0^x\\psi=\\int_1^x\\psi\\ (x>1).",
      "normalization_proofs": [
        {
          "file": "Solutions/RHOcticPush.v1/box/perron/BoxIntegratedSource.lean",
          "declaration": "integrated_source_normalized",
          "physical_line": 20,
          "source_sha256": "61080c79db689ef81bb12226977e11491959a688b69ddf81e287fe008f0542ed",
          "source_excerpt": "theorem integrated_source_normalized (h : SourceIntegratedPsiRaw) :\n    SourceIntegratedPsi := by\n  obtain ⟨C, hC⟩ := h\n  refine ⟨C, ?_⟩\n  intro x hx\n  simpa only [RHOcticPush.BoxCDF.box_log_constant] using hC x hx"
        },
        {
          "file": "Solutions/RHOcticPush.v1/box/perron/BoxIntegratedSource.lean",
          "declaration": "psi1_integral_from_zero",
          "physical_line": 29,
          "source_sha256": "61080c79db689ef81bb12226977e11491959a688b69ddf81e287fe008f0542ed",
          "source_excerpt": "theorem psi1_integral_from_zero (x : ℝ) : psi1 x = ∫ t in (0:ℝ)..x, Chebyshev.psi t := by\n  have hz : (∫ t in (0:ℝ)..1, Chebyshev.psi t) = 0 := by\n    calc\n      _ = ∫ _t in (0:ℝ)..1, (0:ℝ) := by\n        apply intervalIntegral.integral_congr\n        intro t ht\n        exact Chebyshev.psi_eq_zero_of_le_one (by\n          simpa only [max_eq_right (by norm_num : (0:ℝ) ≤ 1)] using ht.2)\n      _ = 0 := intervalIntegral.integral_zero\n  have he := intervalIntegral.integral_add_adjacent_intervals (μ := volume)\n    (Chebyshev.psi_mono.intervalIntegrable (a := 0) (b := 1))\n    (Chebyshev.psi_mono.intervalIntegrable (a := 1) (b := x))\n  simpa only [hz,zero_add,psi1] using he"
        }
      ],
      "constant_note": "Source printsC=ζprime(-1)/ζ(-1). The actual weaker Lean contract keeps∃C because it cancels. Canonicalraw and provednormalized formulations are one added input, not two assumptions."
    }
