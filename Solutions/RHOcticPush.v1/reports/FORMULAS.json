  "green": "\\begin{gathered}W\\in C_c^\\infty(\\mathbb R,\\mathbb R),\\quad \\operatorname{supp}W\\subseteq[1,\\infty),\\quad X>1,\\\\\\sum_{n\\ge1}\\Lambda(n)W(n/X)=X\\int_0^\\infty W(t)\\,dt-\\sum_{\\substack{\\zeta(\\rho)=0\\\\\\rho\\ne1}}m_\\rho X^\\rho\\mathcal M(W,\\rho),\\\\\\mathcal M(W,s)=\\int_0^\\infty W(t)t^s\\frac{dt}{t};\\quad\\text{the zero-packet series is summable}.\\end{gathered}",
  "bpt": "\\left|N(T)-\\left(\\frac{T}{2\\pi}\\log\\frac{T}{2\\pi}-\\frac{T}{2\\pi}+\\frac78\\right)\\right|\\le0.28\\log T,\\quad T\\ge2\\pi.",
  "infinite": "\\sum_{\\gamma>a}m_\\rho|f(\\gamma)|\\le\\int_a^\\infty |f(t)|\\frac{\\log(t/(2\\pi))}{2\\pi}\\,dt+0.28\\left(|f(a)|\\log a+\\int_a^\\infty|f^\\prime(t)|\\log t\\,dt\\right).",
  "zerofixed": "\\|Z_4(C,L)\\|\\le1.822\\!\\left(\\frac L2-\\log\\!\\left(2\\pi\\left(\\frac{CL}{2}-1\\right)\\right)\\right)+1.5+R,\\quad R=0.024\\ (C=2.15),\\ R=0.15\\ (1.03\\le C\\le16).\\quad L\\ge24.",
  "strongfixed": "\\forall u\\ge e^{24},\\quad \\#\\{p:u<p<u+2.15\\sqrt u\\log u\\}>\\left(\\frac{180173}{180000}+\\frac{5.8}{\\log u}\\right)\\sqrt u,\\quad \\frac{180173}{180000}-\\frac{9001}{9000}=\\frac{17}{20000}.",
