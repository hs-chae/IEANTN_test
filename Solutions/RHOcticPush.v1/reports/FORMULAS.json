  "gmoldnew": "B_{\\rm old}(x)=14.44+\\frac{0.1386\\sqrt x}{L(L-6)},\\quad B_5(x)=15.51+\\frac{0.1386\\sqrt x}{L(L-5)},\\quad L=\\log x.",
  "gmminimum": "B_*(x)=\\begin{cases}B_{\\rm old}(x),&e^{12}\\le x<e^{15},\\\\\\min\\{B_{\\rm old}(x),B_5(x)\\},&x\\ge e^{15},\\end{cases}\\quad B_{\\rm old}(x)-B_*(x)>\\frac12\\ (x\\ge e^{24}).",
  "gmerror": "E(x)=J(x)-\\operatorname{li}(x)-\\frac{\\psi(x)-x}{\\log x},\\quad E(x)-E(y)=\\int_y^x\\frac{\\psi(t)-t}{t\\log^2t}\\,dt.",
  "gmpair": "KE(x)-eE(y)=K(E(x)-E(y))-(e-K)E(y),\\quad 0\\le K\\le e,\\quad e^{15}\\le y\\le x.",
  "gmpairbound": "KE(x)-eE(y)\\le K\\!\\left(A_5(x)-A_5(y)+2G(y)w(y)+\\frac{1.838}{\\log y}\\right)+(e-K)(15.51+A_5(y)).",
  "gmprimitive": "G(t)=0.0462t^{3/2}+1.838t+1.9851+0.5097/t,\\quad w(t)=\\frac1{t\\log^2t},\\quad A_5(t)=\\frac{0.1386\\sqrt t}{\\log t(\\log t-5)}.",
  "gmunsigned": "T_{\\rm GM}(a,x)\\ge\\frac{0.0924\\sqrt x}{\\log^2x}>\\frac{0.076\\sqrt x}{\\log^2x},\\quad 3\\le a,\\quad4a\\le x.",
  "pitransfer": "\\left|\\pi(e^L)-\\operatorname{Li}_2(e^L)\\right|\\le\\frac{e^{L/2}}L f(L)+B_*(e^L)+Q(L)+2,\\quad L\\ge12.",
  "Q": "Q(L)=\\frac{2\\log4}{L}e^{L/2}+\\frac12e^{L/4}+e^{L/3}\\log\\!\\left(\\frac{L}{\\log2}\\right),\\quad \\operatorname{Li}_2(x)=\\int_2^x\\frac{dt}{\\log t}.",
  "nicolasbeta": "\\beta=2+\\gamma-\\log\\pi-2\\log2,\\quad w_\\rho=\\frac{m_\\rho}{|\\rho|^2}\\ge0,\\quad W(x)=\\sum_\\rho w_\\rho\\cos(\\gamma_\\rho\\log x).",
  "fejer": "4\\cos t+3\\cos2t+2\\cos3t+\\cos4t+\\frac52=\\frac12(4\\cos^2t+2\\cos t-1)^2\\ge0.",
  "euler": "S(x)=\\sqrt x\\log x\\log\\frac{\\prod_{p\\le x}(1-1/p)^{-1}}{e^\\gamma\\log\\theta(x)},\\quad P(x)=\\frac{2+\\beta}{\\log x}+\\frac{4\\beta}{\\log^2x}+\\frac{\\sqrt x\\log x}{2(x-1)}.",
  "four": "4S(x)+3S(x^2)+2S(x^3)+S(x^4)\\ge20-\\frac52\\beta-4P(x)-3P(x^2)-2P(x^3)-P(x^4),\\quad x>599.",
  "block": "\\forall x>599,\\ \\exists k\\in\\{1,2,3,4\\}:\\quad S(x^k)\\ge2-\\frac\\beta4-P(x^k).",
  "boxmoments": "J_0=\\int_0^\\infty\\frac{|\\sin y/y|-\\mathbf1_{y\\le1}}y\\,dy,\\quad J_1=\\int_0^\\infty\\frac{|\\sin y/y|-\\mathbf1_{y\\le1}}y\\log y\\,dy.",
  "boxopen": "J_0=\\log2,\\quad J_1=-\\gamma_1-q+a\\log2-\\frac{a^2}{2}+\\frac12+\\frac{\\pi^2}{24},\\quad a=1-\\gamma-\\log2,\\ q=\\sum_{n\\ge2}\\frac{\\log n}{n(4n^2-1)}.",
  "boxseries": "|\\sin x|=\\frac2\\pi-\\frac4\\pi\\sum_{n\\ge1}\\frac{\\cos(2nx)}{4n^2-1}=\\frac4\\pi\\sum_{n\\ge1}\\frac{1-\\cos(2nx)}{4n^2-1}.",
  "boxgain": "J_1<0.70871\\quad(\\text{previously }0.70875),\\qquad f_{\\rm old}(L)-f_{\\rm new}(L)=\\frac1{25000\\pi}.",
  "lee": "|\\psi(x)-x|\\le\\frac{\\sqrt x\\log x(\\log x-\\log\\log x)}{8\\pi},\\quad x\\ge101,\\quad\\text{RH}.",
  "cpdl": "\\inf\\left\\{c>0:\\liminf_{x\\to\\infty}\\frac{\\pi(x+c\\sqrt x\\log x)-\\pi(x)}{\\sqrt x}>\\alpha\\right\\}<0.8358(1+2\\alpha).",
  "boxfunctions": "v(L)=L/2-\\log L,\\quad f_j(L)=\\frac{v(L)^2+2\\log2\\,v(L)+2j+L}{2\\pi}+0.14,\\quad j_{\\rm old}=0.70875,\\ j_{\\rm new}=0.70871,\\quad f_{\\rm Box}=f_{0.70871}.",
  "endpoint": "F(q)=A(q)\\cos q+B(q)\\sin q,\\quad A(q)=-16/q^2+672/q^4-13440/q^6+80640/q^8,\\quad B(q)=112/q^3-3360/q^5+40320/q^7-80640/q^9,\\quad q\\ne0;\\ F(0)=16/9.",
  "strongcaps": "M_0\\le\\frac{3574}{625}=5.7184,\\quad M_1\\le\\frac{572}{125}=4.576,\\quad M_0\\le1.8203\\pi,\\quad M_1\\le1.457\\pi.",
  "narrowest": "\\#\\{p:u<p<u+2.14891875\\sqrt u\\log u\\}>\\left(1+\\frac{4.2}{\\log u}\\right)\\sqrt u,\\quad u\\ge e^{24}.",
  "triples": "T(n)=\\#\\{(a,b,p)\\in\\mathbb N^3:a,b,p\\text{ prime},\\ a\\le b\\le p,\\ a+b+p=n\\}.",
  "triplehyp": "n\\text{ odd},\\quad \\operatorname{GoldbachEvenUpTo}(H),\\quad 2H<n,\\quad u=n-H\\ge e^{24},\\quad 2.14891875\\sqrt u\\log u\\le H-4.",
  "triplebound": "T(n)>\\left(1+\\frac{4.2}{\\log u}\\right)\\sqrt u.",
  "lee_strong": "|\\psi(x)-x|\\le\\sqrt x\\log x\\left[\\frac{\\log x}{8\\pi}-\\left(\\frac1{2\\pi}+\\frac{1.465}{\\log x}\\right)\\log\\log x+1.2325\\right],\\quad x\\ge11,\\quad\\text{RH}.",
  "boxgamma": "\\int_0^\\infty(1-\\cos y)y^{s-2}\\,dy=\\frac{\\pi}{2\\Gamma(2-s)\\cos(\\pi s/2)},\\quad 0<s<1.",
  "boxfactor": "\\mathcal M_{\\rm box}(s)=P(s)[\\zeta(1+s)+H(s)],\\quad P(s)=\\frac{2^{-s}}{\\Gamma(2-s)\\cos(\\pi s/2)},\\quad H(s)=\\sum_{n\\ge1}\\frac{n^{-1-s}}{4n^2-1}.",
  "boxderivatives": "P(0)=1,\\ P^\\prime(0)=a,\\ P^{\\prime\\prime}(0)=a^2+1+\\frac{\\pi^2}{12};\\quad R(0)=\\gamma,\\ R^\\prime(0)=-\\gamma_1,\\ H(0)=2\\log2-1,\\ H^\\prime(0)=-q.",
  "boxcoefficients": "J_0=a+\\gamma+2\\log2-1=\\log2,\\quad J_1=\\frac{a^2+1+\\pi^2/12}{2}+a(\\gamma+2\\log2-1)-\\gamma_1-q=-\\gamma_1-q+a\\log2-\\frac{a^2}{2}+\\frac12+\\frac{\\pi^2}{24}.",
  "lee_short": "|\\theta(x+h)-\\theta(x)-h|<\\left(\\frac{\\log(h/(\\sqrt x\\log x))}{\\pi}+\\mathcal L+\\frac{1.046}{\\log x}\\right)\\sqrt x\\log x,\\quad x\\ge e^{20},\\ \\sqrt x\\log x\\le h\\le x^{3/4}.",
  "lee_L": "\\mathcal L=\\frac2{\\pi+\\sqrt{\\pi^2+4\\pi}}+\\frac1\\pi\\left(2+\\log\\frac{\\pi(\\pi+\\sqrt{\\pi^2+4\\pi}+2)}4\\right)=1.54262\\ldots.",
  "lee_published": "|\\psi(x+\\sqrt x\\log x)-\\psi(x)-\\sqrt x\\log x|<k_3(x_0)\\sqrt x\\log x-k_4(x_0),\\quad x\\ge x_0\\ge e^{10};\\quad k_3(e^{200})=0.45974,\\ k_3(e^{500})=0.3355.",
  "lee_T": "T_0(x)=\\frac{\\pi\\sqrt x}{\\log x}\\left(1+\\frac{\\log x}{2\\pi\\sqrt x}\\right)^{-1}\\left[\\left(1+\\frac{\\log x}{\\pi\\sqrt x}\\right)^2+1\\right],\\quad H_1=10^7,\\quad\\omega_1=16.2106480369.",
  "lee_lemma": "\\frac{|\\psi(x)-x|}{x}\\le\\frac{\\log x}{2\\pi\\sqrt x}+\\frac{\\log(2\\pi)-\\tfrac12\\log(1-x^{-2})}{x}+x^{-1/2}\\left(1+\\frac{\\log x}{2\\pi\\sqrt x}\\right)\\left[\\frac{\\log^2(T_0(x)/(2\\pi))}{2\\pi}+\\frac{\\log T_0(x)}{\\pi T_0(x)}+\\omega_1+\\frac{8\\log H_1+4}{H_1}-\\frac{\\log^2(H_1/(2\\pi))}{2\\pi}\\right],\\quad x\\ge10^{19},\\quad\\text{RH}.",
  "boxnotation": "a=1-\\gamma-\\log2,\\quad q=\\sum_{n\\ge2}\\frac{\\log n}{n(4n^2-1)},\\quad \\gamma_1=\\lim_{N\\to\\infty}\\left(\\sum_{n=1}^{N}\\frac{\\log n}{n}-\\frac{\\log^2 N}{2}\\right),\\quad R(s)=\\zeta(1+s)-1/s\\ (s\\ne0),\\ R(0)=\\gamma.",
  "boxzerobound": "\\forall L\\ge35,\\ s\\le1:\\quad\\sum_{\\rho}\\|P_\\rho(s,L)\\|<\\infty,\\qquad\\left\\|\\sum_{\\rho}P_\\rho(s,L)\\right\\|\\le e^{L/2}\\left[\\frac{v(L)^2+2J_0v(L)+2J_1}{2\\pi}+0.131\\right].",
  "perron_general": "\\psi_1(x)=\\int_0^x\\psi(t)\\,dt=\\frac{x^2}{2}-\\sum_{\\rho}\\frac{m_\\rho x^{\\rho+1}}{\\rho(\\rho+1)}-x\\frac{\\zeta^\\prime(0)}{\\zeta(0)}+C-\\sum_{n\\ge1}\\frac{x^{1-2n}}{2n(2n-1)},\\quad x>1.",
  "perron_transport": "T_{A,B}[F]=\\frac{F(B)}B-\\frac{F(A)}A+\\int_A^B\\frac{F(t)}{t^2}\\,dt,\\quad T_{A,B}[\\psi_1]=\\int_A^B\\frac{\\psi(t)}t\\,dt,\\quad A=e^Le^{(s-1)\\delta},\\ B=e^Le^{(s+1)\\delta}.",
  "lee_eq10_printed": "\\text{Lee–Nosal, Eq. (10):}\\qquad\\sum_{0<|\\gamma|\\le10^7}\\frac1{|\\gamma|}\\le16.2106480369.",
  "fks_table_positive": "\\text{FKS, Eq. (2.4), Table 1:}\\qquad S_0-10^{-10}<\\sum_{0<\\gamma<T_0}\\frac1\\gamma<S_0,\\quad T_0=10^7,\\ S_0=16.2106480369.",
  "positive_inverse_derivation": "\\begin{aligned}a&=1000,\\quad b=10^7,\\\\\\sum_{a<\\gamma\\le b}\\frac{m_\\rho}{\\gamma}&\\ge\\frac{\\log^2(b/(2\\pi))-\\log^2(a/(2\\pi))}{4\\pi}-0.28\\left(\\frac{\\log b}{b}+\\frac{2\\log a+1}{a}\\right)>14,\\\\\\sum_{0<|\\gamma|\\le10^7}\\frac{m_\\rho}{|\\gamma|}&\\ge2\\sum_{1000<\\gamma\\le10^7}\\frac{m_\\rho}{\\gamma}>28.\\end{aligned}",
  "spectral_profile": "D(x)=J(x)-\\operatorname{li}(x)-\\frac{\\psi(x)-x}{\\log x},\\qquad P(L)=\\frac{579}{125}+\\frac{47}{1000}\\left(1+\\frac4{L-8}\\right)\\frac{e^{L/2}}{L^2}.",
  "spectral_actual": "\\begin{aligned}|D(x)|&\\le P(\\log x)<0.076\\frac{\\sqrt x}{\\log^2x},&&x\\ge e^{24},\\\\|D(x)|&<0.055\\frac{\\sqrt x}{\\log^2x},&&x\\ge e^{35}.\\end{aligned}",
  "spectral_signed": "\\begin{aligned}A_\\rho(t)&=\\frac{m_\\rho t^{\\rho+1}}{\\rho(\\rho+1)},\\quad w(t)=\\frac1{t\\log^2t},\\quad B_\\rho(t)=\\frac{m_\\rho t^\\rho}{\\rho^2\\log^2t},\\\\A_\\rho(b)w(b)-A_\\rho(a)w(a)-\\int_a^b A_\\rho(t)w^\\prime(t)\\,dt&=B_\\rho(b)-B_\\rho(a)+\\frac{2m_\\rho}{\\rho^2}\\int_a^b\\frac{t^{\\rho-1}}{\\log^3t}\\,dt,\\qquad1<a\\le b.\\end{aligned}",
  "spectral_remainder": "R_8(t)=\\frac{2\\sqrt t}{\\log^2t(\\log t-8)},\\qquad \\int_3^x\\frac{dt}{\\sqrt t\\log^3t}\\le8+R_8(x),\\quad x\\ge e^{24};\\qquad R_8^\\prime(t)-\\frac1{\\sqrt t\\log^3t}=\\frac{2(\\log t-16)}{\\sqrt t\\log^3t(\\log t-8)^2}\\ge0\\quad(t\\ge e^{16}).",
  "spectral_pi": "\\begin{aligned}U_{\\rm comp}(f,L)&=\\frac{e^{L/2}}L f(L)+P(L)+Q(L)+2,\\\\|\\pi(e^L)-\\operatorname{Li}_2(e^L)|&\\le U_{\\rm comp}(f,L),\\quad L\\ge24,\\quad |\\psi(e^L)-e^L|\\le e^{L/2}f(L),\\\\U_{\\rm old}(f,L)-U_{\\rm comp}(f,L)&=B_*(e^L)-P(L)>14,\\quad L\\ge24.\\end{aligned}",
  "ram606": "F_{606}(x)=\\begin{cases}F^{\\rm strong}_{607}(x),&x\\ge610\\cdot10^9,\\\\1/1000,&x<610\\cdot10^9,\\end{cases}\\qquad R_G(x)\\ge F_{606}(x)\\quad(x\\ge606\\cdot10^9),\\qquad F^{\\rm strong}_{607}(x)\\le F_{606}(x)\\quad(x\\ge607\\cdot10^9).",
  "ram_coefficients": "c_j=\\sum_{i=0}^j i!\\binom ji-\\sum_{i=0}^j i!(j-i)!,\\quad P_{20}(v)=\\sum_{j=0}^{20}c_jv^j,\\quad d_j=\\sum_{i=0}^{19-j}(i+j+1)!(20-i)!\\quad(0\\le j\\le19).",
  "ram_tail_terms": "\\begin{aligned}A(v)&=\\sum_{j=0}^{19}d_jv^{j+17}+\\frac{11}{5}\\bigl(7\\cdot21!\\,v^{17}\\bigr)+\\bigl(7\\cdot21!\\,v^{17}\\bigr)^2,\\\\a_R&=\\frac1{8\\pi},\\quad D_{a_R}(L)=a_R L^5(L-1)e^{(1-L)/2}+\\frac{21}{10}a_R L^6e^{-L/2}+a_R^2L^8e^{-L},\\\\B_R(L)&=L^4P_{20}(1/L)-A(1/L)-D_{a_R}(L).\\end{aligned}",
  "ram_retained_profile": "\\begin{aligned}F_{640}(x)&=\\begin{cases}\\max\\{1+14/\\log x+144/\\log^2x,\\ B_R(\\log x)\\},&x\\ge e^{70},\\\\\\max\\{4/5,\\ B_R(\\log x)\\},&e^{42}\\le x<e^{70},\\\\1/12,&640\\cdot10^9\\le x<e^{42},\\end{cases}\\\\F^{\\rm strong}_{607}(x)&=\\begin{cases}F_{640}(x),&x\\ge640\\cdot10^9,\\\\1/80,&620\\cdot10^9\\le x<640\\cdot10^9,\\\\1/100,&619\\cdot10^9\\le x<620\\cdot10^9,\\\\1/1000,&610\\cdot10^9\\le x<619\\cdot10^9,\\\\1/10000,&607\\cdot10^9\\le x<610\\cdot10^9.\\end{cases}\\end{aligned}",
  "pnt_clean04": "\\left|\\pi(x)-\\operatorname{Li}_2(x)\\right|<\\sqrt x\\left(\\frac{\\log x}{8\\pi}-\\frac25\\right),\\qquad x\\ge e^{100}.",
  "pnt_clean_gain": "\\sqrt x\\left(\\frac{\\log x}{8\\pi}-\\frac13\\right)-\\sqrt x\\left(\\frac{\\log x}{8\\pi}-\\frac25\\right)=\\frac{\\sqrt x}{15}>0\\quad(x\\ge e^{100}).",
  "pnt_clean_budget": "U_{\\rm comp}(f_{\\rm Box},L)<\\left(f_{\\rm Box}(L)+\\frac{14}{5}\\right)\\frac{e^{L/2}}L,\\quad f_{\\rm Box}(L)+\\frac{14}{5}<\\frac{L^2}{8\\pi}-\\frac25L,\\qquad L\\ge100.",
  "pnt_clean_points": "\\begin{aligned}U_{\\rm comp}(f_{\\rm Box},100)&<3.5704e^{50},\\\\3.57887&<100/(8\\pi)-2/5<3.57888,\\\\3.64554&<100/(8\\pi)-1/3<3.64555.\\end{aligned}",
  "feedback_upper": "\\begin{aligned}\\mathcal J_{\\uparrow}(s)&=\\operatorname{li}(e^s)+\\frac{e^{s/2}}s f_{\\rm Box}(s)+P(s),\\\\\\pi(e^s)&\\le J(e^s)\\le\\mathcal J_{\\uparrow}(s)\\quad(s\\ge35),\\\\\\mathcal J_{\\uparrow}(s)&<\\frac{11}{10}\\frac{e^s}s\\quad(s\\ge50).\\end{aligned}",
  "feedback_q": "\\begin{aligned}T(L)&=\\frac{e^{L/4}}2+e^{L/3}\\log\\!\\frac L{\\log2},\\\\Q_0(L)&=2\\log4\\,\\frac{e^{L/2}}L+T(L),\\\\Q_{\\rm raw}(L)&=\\frac12\\mathcal J_{\\uparrow}(L/2)+T(L),\\\\Q_{\\rm eff}(L)&=\\begin{cases}Q_0(L),&L<70,\\\\\\min\\{Q_0(L),Q_{\\rm raw}(L)\\},&L\\ge70.\\end{cases}\\end{aligned}",
  "feedback_full": "\\begin{aligned}U_{\\rm fb}(L)&=\\frac{e^{L/2}}L f_{\\rm Box}(L)+P(L)+Q_{\\rm eff}(L)+2,\\\\|\\pi(e^L)-\\operatorname{Li}_2(e^L)|&\\le U_{\\rm fb}(L)\\le U_0(L),\\quad L\\ge35,\\\\U_0(L)&=\\frac{e^{L/2}}L f_{\\rm Box}(L)+P(L)+Q_0(L)+2.\\end{aligned}",
  "feedback_whole_gain": "\\begin{aligned}U_0(L)-U_{\\rm fb}(L)&>\\frac{167}{100}\\frac{e^{L/2}}L,\\quad L\\ge100,\\\\2\\log4-\\frac{11}{10}&>\\frac{167}{100},\\\\U_{\\rm fb}(L)&<\\left(f_{\\rm Box}(L)+\\frac{113}{100}\\right)\\frac{e^{L/2}}L,\\quad L\\ge100.\\end{aligned}",
  "feedback_clean": "\\begin{aligned}|\\pi(x)-\\operatorname{Li}_2(x)|&<\\sqrt x\\left(\\frac{\\log x}{8\\pi}-\\frac{21}{50}\\right),\\quad x\\ge e^{100},\\\\\\sqrt x\\left(\\frac{\\log x}{8\\pi}-\\frac25\\right)-\\sqrt x\\left(\\frac{\\log x}{8\\pi}-\\frac{21}{50}\\right)&=\\frac{\\sqrt x}{50}>0.\\end{aligned}",
  "feedback_budget": "\\begin{aligned}f_{\\rm Box}(L)+\\frac{113}{100}&\\le\\frac{(L/2-4.6)^2+1.4(L/2-4.6)+1.41742+L}{2\\pi}+1.27,\\\\(11.6-3.36\\pi)L-64.54968-10.16\\pi&>0\\quad(L\\ge100).\\end{aligned}",
  "feedback_points": "\\begin{aligned}U_{\\rm fb}(100)&<3.5537e^{50},\\\\U_0(100)&<3.5704e^{50},\\\\3.55887&<100/(8\\pi)-21/50<3.55888.\\end{aligned}",
  "box_lee_comparison": "\\forall L\\ge35,\\quad f_{\\rm Box}(L)<\\min\\!\\left\\{\\frac{L^2}{8\\pi}-\\left(\\frac1{2\\pi}+\\frac{1.465}{L}\\right)L\\log L+1.2325L,\\ \\frac{L(L-\\log L)}{8\\pi}\\right\\},\\quad f_{\\rm Box}=f_{0.70871}."
