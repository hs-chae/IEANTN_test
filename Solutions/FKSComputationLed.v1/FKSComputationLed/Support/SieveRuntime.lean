import Init

namespace FKSComputationLed.Sieve

/-- Small-base trial division; the full bitmap is generated by the sieve below. -/
def trialLoop (n next fuel : Nat) : Bool :=
  match fuel with
  | 0 => true
  | fuel+1 => if n % next = 0 then false else trialLoop n (next+1) fuel

def basePrime (n : Nat) : Bool :=
  if n < 2 then false else trialLoop n 2 (Nat.sqrt n + 1 - 2)

def sieveRead (a : Array Bool) (n : Nat) : Bool := a[n]?.getD false

def markLoop (p next fuel : Nat) (a : Array Bool) : Array Bool :=
  match fuel with
  | 0 => a
  | fuel+1 => markLoop p (next+1) fuel (a.setIfInBounds (p*next) false)

def markPrime (X p : Nat) (a : Array Bool) : Array Bool :=
  markLoop p p (X/p+1-p) a

def sieveLoop (X next fuel : Nat) (a : Array Bool) : Array Bool :=
  match fuel with
  | 0 => a
  | fuel+1 =>
    let a' := if basePrime next then markPrime X next a else a
    sieveLoop X (next+1) fuel a'

def sieveInitial (X : Nat) : Array Bool :=
  ((Array.replicate (X+1) true).setIfInBounds 0 false).setIfInBounds 1 false

def primeSieve (X : Nat) : Array Bool :=
  sieveLoop X 2 (Nat.sqrt X + 1 - 2) (sieveInitial X)

def primeWords (X L : Nat) : Array UInt32 :=
  (primeSieve X).map (fun b => if b then (1 : UInt32) else 0) ++
    Array.replicate (L-(X+1)) 0

end FKSComputationLed.Sieve
