def check (ps : Array UInt32) (z : Cell) : Bool :=
  let wt := pointInfo z.b
  decide (3≤z.n ∧ z.n≤40000 ∧ z.n*z.n≤z.a ∧ 4≤z.c) &&
    NativeRanks.rankCheck ps z.n z.c && wt.valid &&
    (LeanCert.Core.IntervalDyadic.mul
      (LeanCert.Core.IntervalDyadic.ofIntervalRat
        ⟨(z.c:ℚ)/2-2,(z.c:ℚ)/2-2,le_rfl⟩ cfg.precision) wt.weightI).lowerBoundedBy (10/9)
def gate : Bool :=
  let ps := Sieve.oddPrimeList 40000
  cells.all (check ps)
def shape : Nat → List Cell → Bool
  | p, [] => decide (p=1000000000)
  | p,z::zs => decide (p=z.a ∧ z.a<z.b ∧ z.b≤1000000000) && shape z.b zs
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
theorem checked : gate=true := by native_decide
theorem covered : shape 100000000 cells=true := by native_decide
#print axioms checked
#print axioms covered
end FKSComputationLed.BaselineProgram
