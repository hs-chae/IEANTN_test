/-- The original support-seven whole-line norm, now deriving its numerical
leaf from the complete checked N24 integer trace. Kernel-only until the
actual C execution refinement is consumed. -/
theorem kernel_actual_norm (hBRNorm : SourceBRFourierNormFive) :
    (∫ u : ℝ, |inverseCosine (affineSpectrum RH080Next.WindowPV.Data.affineNodes 360) u|) ≤
      (7813568381304104:ℝ)/10000000000000000 := by
  have h := RH080Next.Primal.W4FFTKernel.actual_norm_from_trace24 hBRNorm
    stages output complete_execution seed topTail
    (by rw [←top_shape]; exact length_w24) decoded_seed_exact
    (by simpa only [top_shape,List.tail_cons] using global_twiddle_trace)
    (by intro t ht; rw [←top_shape]; exact all_stage_chains t ht)
  apply h.trans
  rw [numerator_checked]
  norm_num

