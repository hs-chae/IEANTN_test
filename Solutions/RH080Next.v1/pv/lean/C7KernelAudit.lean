/-- Only generated N24 data/checker modules in the verified pure import DAG may be pruned. -/
private def c7PrunableData (env : Environment) (pureModules : NameSet) (name : Name) : Bool :=
  match env.getModuleIdxFor? name with
  | none => false
  | some idx =>
    let moduleName := env.header.moduleNames[idx]!
    pureModules.contains moduleName && moduleName.toString.startsWith "W4D24"

private partial def c7ValueClosure (env : Environment) (pureModules : NameSet) :
    List Name → NameSet → NameSet → NameSet × NameSet
  | [], seen, pruned => (seen, pruned)
  | name :: rest, seen, pruned =>
    if seen.contains name then c7ValueClosure env pureModules rest seen pruned else
    let seen := seen.insert name
    if !c7ProjectName name then c7ValueClosure env pureModules rest seen pruned else
    if c7PrunableData env pureModules name then
      c7ValueClosure env pureModules rest seen (pruned.insert name)
    else
    match env.find? name with
    | none => c7ValueClosure env pureModules rest seen pruned
    | some info =>
      let used := info.type.getUsedConstants
      let used := match info with
        | .thmInfo t => used ++ t.value.getUsedConstants
        | .defnInfo t => used ++ t.value.getUsedConstants
        | .opaqueInfo t => used ++ t.value.getUsedConstants
        | _ => used
      c7ValueClosure env pureModules (used.toList ++ rest) seen pruned

private def c7Forbidden (name : Name) : Bool :=
  let text := name.toString
  let scalar (stem : String) :=
    match text.splitOn stem with
    | _ :: tail :: _ =>
      !(tail.startsWith "Data." || tail.startsWith "Model." || tail.startsWith "q" ||
        tail.startsWith "actual_q" || tail == "actual_input_coefficients" ||
        tail.startsWith "actual_input_coefficients.")
    | _ => false
  let has (piece : String) := (text.splitOn piece).length != 1
  let privateSource := #["WindowSource", "WindowAST", "WindowExecution", "WindowMain",
    "WindowActualF0", "WindowActualArea", "WindowActualHeight", "WindowActualV0",
    "WindowActualV1", "WindowActualMu2", "WindowActualMaximum", "WindowSourceFinal",
    "FapSource", "FapAST", "FapExecution", "FapMain", "FapSourceFinal", "ScalarHost"]
  has "GoldbachDirect." || has "RH080Next.FFTPV." ||
    privateSource.any (fun stem => text.startsWith ("_private." ++ stem ++ ".")) ||
    scalar "RH080Next.WindowPV." || scalar "RH080Next.FapPV." ||
    text.startsWith "RH080Next.ScalarHost." ||
    has "SourceSyntax" || has "checkedSource" ||
    has "acceptedSource" || has "SameSource" ||
    has "sourceChars" || text.startsWith "IO." || text.startsWith "BaseIO."

run_cmd liftTermElabM do
  let env ← getEnv
  let root := `RH080Next.PosthocKernelControl.matched_fully_kernel_global
  let info ← getConstInfo root
  for reference in #[`RH080Next.FFTPV.W4Main.source_w4_global,
      `RH080Next.FFTPV.W4Main.matched_kernel_fft_global] do
    let expected ← getConstInfo reference
    unless (← isDefEq info.type expected.type) do
      throwError "Exact same mathematical type failed against {reference}"
  let allowed := #[`propext, `Classical.choice, `Quot.sound]
  let axes ← collectAxioms root
  unless axes.all allowed.contains do throwError "Forbidden control axiom: {axes}"
  let pureModules ← match c7ModuleClosure env [`W4FFTCertifiedNorm] {} with
    | .ok names => pure names
    | .error message => throwError "{message}"
  unless pureModules.toList.length == c7ExpectedPureNormModules.size do
    throwError "Actual pure norm import graph size differs from retained source headers"
  for moduleName in c7ExpectedPureNormModules do
    unless pureModules.contains moduleName do
      throwError "Source/header versus imported-module mismatch: {moduleName}"
  let mut normDeclarationCount : Nat := 0
  for moduleName in pureModules.toList do
    let some idx := env.getModuleIdx? moduleName | throwError "Missing {moduleName}"
    for name in (env.header.moduleData[idx]!).constNames do
      normDeclarationCount := normDeclarationCount + 1
      if c7Forbidden name then
        throwError "C-source/correspondence/run declaration in pure norm module: {name}"
  let (used, pruned) := c7ValueClosure env pureModules [root] {} {}

  for name in used.toList do
    if c7Forbidden name then throwError "Actual C-source/run dependency remains: {name}"
  let required := #[`W4DAG24.kernel_actual_norm,
    `RH080Next.PosthocKernelControl.scalar_caps,
    `RH080Next.PosthocKernelControl.global_of_kernel_norm,
    `RH080Next.Explicit.actual_prime_interval_of_residual,
    `RH080Next.Explicit.cms_zero_partial_summation_kernel,
    `RH080Next.FiniteGap.finite_open_08_through_exp42,
    `RH080Next.WindowPV.actual_qMassA0, `RH080Next.WindowPV.actual_qV0,
    `RH080Next.WindowPV.actual_input_coefficients,
    `RH080Next.WindowPV.actual_qPositiveArea]
  for name in required do
    unless used.contains name do throwError "Required matched kernel provider absent: {name}"
