import C7KernelGlobal
import FFTW4MainConsumers
import Lean
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 2000000

open Lean Elab Command Meta

private def c7ProjectName (name : Name) : Bool :=
  let text := name.toString
  text.startsWith "RH080Next." || text.startsWith "W4DAG24." ||
    text.startsWith "FapForest17." || text.startsWith "IEANTN." ||
  text.startsWith "GoldbachDirect." ||
    (text.startsWith "_private." && !text.startsWith "_private.Mathlib." &&
      !text.startsWith "_private.Lean." && !text.startsWith "_private.Std.")

private def c7GenericModule (name : Name) : Bool :=
  #["Mathlib", "Lean", "Init", "Std", "Aesop", "Batteries", "Qq", "ProofWidgets"].contains
    ((name.toString.splitOn ".").head!)

/-- Read the actual imported-module graph; generic pinned libraries are its boundary. -/
private partial def c7ModuleClosure (env : Environment) :
    List Name → NameSet → Except String NameSet
  | [], seen => .ok seen
  | name :: rest, seen => do
    if c7GenericModule name || seen.contains name then c7ModuleClosure env rest seen else
    let some idx := env.getModuleIdx? name | throw s!"Missing actual module: {name}"
    let direct := (env.header.moduleData[idx]!).imports.toList.map (·.module)
    c7ModuleClosure env (direct ++ rest) (seen.insert name)

