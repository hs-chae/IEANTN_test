'RHContinuation.Ramanujan.final_ramanujan_profile' depends on axioms: [propext, Classical.choice, Quot.sound]
'RHContinuation.Ramanujan.final_gap_profile' depends on axioms: [propext, Classical.choice, Quot.sound]
final_ramanujan_profile : SharedRH.hypothesis →
  Buthe.v1.table_2_interval_bounds →
    Buthe.v1.theorem_2_li_minus_riemann_pi →
      Buthe.v1.theorem_2_li_minus_pi →
        Buthe.v1.theorem_2_li_gt_pi →
          Buthe2016.v1.theorem_2_li_minus_pi → ∀ {x : ℝ}, 640000000000 ≤ x → finalMargin x ≤ RamStudy.RG x
