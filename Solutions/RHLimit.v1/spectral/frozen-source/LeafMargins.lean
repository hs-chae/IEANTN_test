noncomputable def endpointMargin (l u c d : ℝ) : ℝ :=
  1+14/u+145/u^2+1412/u^3-1/1000 - d*l^5/(l-1)*exp ((1-l)/2) +
  2*(1+1/u)*c*u^4*exp (-u/2) - c^2*l^4*exp (-l)

