/-- The 100 terms the literals enclose from above. -/
def targets : List ℚ := (List.range 100).map fun j => 1 / ((j : ℚ) + 2) ^ 2

theorem certificate : upperCheckChunked source program (1 / 10 ^ 30) (6449 / 10000) = true ∧
    targets.sum ≤ (chunkedValuesOf program).scale * exactTotal (chunkedValuesOf program).pairs ∧
    (chunkedValuesOf program).ops = [] := by
  native_decide

/-- Through the chunked contract: the 100 terms sum to at most `0.6449`. -/
theorem sum_le : ((targets.sum : ℚ) : ℝ) ≤ ((6449 / 10000 : ℚ) : ℝ) := by
  apply le_bound_of_checkChunked certificate.1
  rw [certificate.2.2]
  simp only [opsConst, Rat.cast_zero, add_zero]
  exact_mod_cast certificate.2.1

