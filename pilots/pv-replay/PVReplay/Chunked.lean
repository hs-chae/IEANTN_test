import PVCore.Chunked
import PVReplay.Table4

/-!
# Chunked sums on the shared contract

`PVCore.ChunkedProgram` lifts the 64-entry limit of one call of the frozen `sum`: the wrapper calls
`sum` once per chunk and adds the results. Two instances:

* **Table 4 QRH in two chunks of 15.** The same 30 cell literals and constants as the selected
  file of `FKS2Numerics.v5`, in a chunked file. Through the chunked bridge it proves
  `FKS2Numerics.v7.qrh_pi` again, with the same analytic enclosures: a real source-linked path.
* **A 100-entry sum** (chunks of 64 and 36), past the single-call limit: upward binary64
  enclosures of `1/(j+2)²`, `j < 100`. A contract test of the chunked semantics, not an
  application: its bound is also checkable by rational arithmetic alone.
-/

namespace PVChunked

open Real PVCore

namespace Table4QRH

def program : ChunkedProgram :=
  ⟨"fks2_table4_transport", [FKS2Table4.selected.inputs.take 15, FKS2Table4.selected.inputs.drop 15],
    FKS2Table4.selected.scale,
    [(.plus, FKS2Table4.selected.anchor), (.plus, FKS2Table4.selected.point),
      (.plus, FKS2Table4.selected.tail)]⟩

def source : String := include_str ".." / "c" / "fks2_table4_transport_chunked.c"

theorem certificate : upperCheckChunked source program (1 / 10 ^ 30) (5 / 10 ^ 16) = true ∧
    (chunkedValuesOf program).pairs.map Prod.fst =
      [FKS2Table4.inputValues.take 15, FKS2Table4.inputValues.drop 15] ∧
    (chunkedValuesOf program).scale = FKS2Table4.scale ∧
    (chunkedValuesOf program).ops = [(.plus, FKS2Table4.anchorUpper),
      (.plus, FKS2Table4.pointUpper), (.plus, FKS2Table4.tailUpper)] := by
  native_decide

theorem total_eq : exactTotal (chunkedValuesOf program).pairs = FKS2Table4.inputValues.sum := by
  have h : ((chunkedValuesOf program).pairs.map fun pr => pr.1.sum) =
      ((chunkedValuesOf program).pairs.map Prod.fst).map List.sum := by
    simp [List.map_map, Function.comp_def]
  unfold exactTotal
  rw [h, certificate.2.1]
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
  exact List.sum_take_add_sum_drop _ 15

theorem bsafe_le : FKS2Pair.Bsafe FKS2Pair.qProfile ≤ ((5 / 10 ^ 16 : ℚ) : ℝ) := by
  apply le_bound_of_checkChunked certificate.1
  rw [total_eq, certificate.2.2.1, certificate.2.2.2]
  have h30 : FKS2Pair.qProfile 30 = FKS2Table4.Q 330 := by norm_num [FKS2Pair.qProfile]
  have h0 : FKS2Pair.qProfile 0 = FKS2Table4.Q 300 := by simp [FKS2Pair.qProfile]
  have ha : FKS2Pair.anchor FKS2Pair.qProfile = FKS2Table4.anchor := by
    simp [FKS2Pair.anchor, FKS2Table4.anchor, h0]
  have hc := FKS2Table4.scaled_cells_upper
  have han := FKS2Table4.anchor_upper
  have hp := FKS2Table4.point_upper
  have ht := FKS2Table4.tail_upper
  simp only [FKS2Pair.Bsafe, ha, FKS2Pair.qCells_eq, h30, opsConst, Rat.cast_add, add_zero]
  linarith

/-- `FKS2Numerics.v7.qrh_pi` through the chunked contract. -/
theorem qrh_pi (hpsi : QRHCH2.v5.psi_refined_bound) (hAnchor : FKS2.v6.table4_anchor_300) :
    FKS2Numerics.v7.qrh_pi := by
  intro x hx
  have h := (FKS2Pair.whole_ray_transport (FKS2Pair.qProfile_valid hpsi) hAnchor x hx).trans bsafe_le
  have hb : (((5 / 10 ^ 16 : ℚ)) : ℝ) = (5 : ℝ) / 10 ^ 16 := by norm_num
  rwa [hb] at h

end Table4QRH

