import Lean

/-!
# native-assisted extractor (local, non-official)

Run inside a solution's Lake environment:

    lake env lean --run <repo>/scripts/native_assisted/Extract.lean <RootModule> <Endpoint> <out.json>

It imports `<RootModule>`, takes the declaration `<Endpoint>`, and writes facts about it, with no
judgement attached. `native_assisted_check.py` reads the JSON and applies the policy. The facts are:

* the endpoint's type, as `pp.all` text;
* every constant in the transitive closure of the endpoint, taken over types, values and recursor
  rules, with its declaring module;
* every axiom in that closure, with its type and source range. For axioms generated by
  `native_decide`, also the decided expression and the native implementations it reaches;
* every `String` literal definition in the closure that is defined in a project module. Each one
  is written to a side file, so the executed C source can be hashed against the file on disk.

Mechanism in this toolchain (`Lean/Meta/Native.lean`, `nativeEqTrue`): `native_decide` compiles
and evaluates a closed `Bool` expression `e`. It then adds the axiom
`<decl>._native.native_decide.ax_<i>_<j> : @Eq Bool e true`, whose declaration range is the tactic
syntax. The extractor reports exactly these data; it does not decide whether they are acceptable.
-/

open Lean Meta

namespace NativeAssisted

def libraryRoots : List String :=
  ["Init", "Std", "Lean", "Lake", "Mathlib", "Batteries", "Aesop", "Qq", "Plausible", "ProofWidgets",
   "ImportGraph", "LeanSearchClient", "Cli"]

def moduleOf (env : Environment) (n : Name) : String :=
  match env.getModuleIdxFor? n with
  | some idx => (env.header.moduleNames[idx.toNat]?.getD `unknown).toString
  | none => "<current>"

def isLibraryModule (m : String) : Bool :=
  libraryRoots.any fun r => m == r || m.startsWith (r ++ ".")

def usedConsts (ci : ConstantInfo) : Array Name := Id.run do
  let mut acc := ci.type.getUsedConstants
  if let some v := ci.value? (allowOpaque := true) then
    acc := acc ++ v.getUsedConstants
  match ci with
  | .recInfo r => for rule in r.rules do acc := acc ++ rule.rhs.getUsedConstants
  | .inductInfo i => acc := acc ++ i.ctors.toArray
  | _ => pure ()
  return acc

/-- Transitive closure of constants reachable from `start`. -/
def closure (env : Environment) (start : Array Name) : NameSet := Id.run do
  let mut seen : NameSet := {}
  let mut stack := start
  while !stack.isEmpty do
    let n := stack.back!
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    if let some ci := env.find? n then
      for m in usedConsts ci do
        if !seen.contains m then stack := stack.push m
  return seen

def kindOf : ConstantInfo → String
  | .thmInfo _ => "theorem" | .defnInfo _ => "def" | .axiomInfo _ => "axiom"
  | .opaqueInfo _ => "opaque" | .quotInfo _ => "quot" | .inductInfo _ => "inductive"
  | .ctorInfo _ => "ctor" | .recInfo _ => "recursor"

/-- Erase binder names (and metadata) so that alpha-equivalent types print identically. -/
partial def canon : Expr → Expr
  | .forallE _ t b bi => .forallE `x (canon t) (canon b) bi
  | .lam _ t b bi => .lam `x (canon t) (canon b) bi
  | .letE _ t v b nd => .letE `x (canon t) (canon v) (canon b) nd
  | .app f a => .app (canon f) (canon a)
  | .mdata _ e => canon e
  | .proj s i e => .proj s i (canon e)
  | e => e

def ppCanon (e : Expr) : MetaM String := do
  withOptions (fun o => o.setBool `pp.all true |>.setBool `pp.fullNames true
      |>.setBool `pp.sanitizeNames false |>.insert `format.width (.ofNat 1000000)) do
    return toString (← ppExpr (canon e))

def ppAll (e : Expr) : MetaM String := do
  withOptions (fun o => o.setBool `pp.all true |>.setBool `pp.fullNames true) do
    return toString (← ppExpr e)

def ppShort (e : Expr) : MetaM String := do
  withOptions (fun o => o.setBool `pp.proofs false) do
    return toString (← ppExpr e)

def rangeJson (n : Name) : MetaM Json := do
  match ← findDeclarationRanges? n with
  | some r => return Json.mkObj [
      ("start_line", toJson r.range.pos.line), ("start_col", toJson r.range.pos.column),
      ("end_line", toJson r.range.endPos.line), ("end_col", toJson r.range.endPos.column)]
  | none => return Json.null

/-- If `n` is `<D>._native.<tactic>.ax_*`, return `(D, tactic)`. -/
def nativeParts? (n : Name) : Option (Name × String) := Id.run do
  let comps := n.components
  let rec go (pre : List Name) : List Name → Option (Name × String)
    | `_native :: tac :: last :: [] =>
        if last.toString.startsWith "ax" then
          some (pre.foldl (fun acc c => acc ++ c) Name.anonymous, tac.toString)
        else none
    | c :: rest => go (pre ++ [c]) rest
    | [] => none
  return go [] comps

def implementations (env : Environment) (roots : Array Name) : Array Json := Id.run do
  let cl := closure env roots
  let mut out : Array Json := #[]
  for n in cl.toList do
    let impl := Compiler.implementedByAttr.getParam? env n
    let ext := isExtern env n
    if impl.isSome || ext then
      let m := moduleOf env n
      out := out.push <| Json.mkObj [
        ("name", toJson n.toString), ("module", toJson m),
        ("library", toJson (isLibraryModule m)),
        ("implemented_by", toJson (impl.map Name.toString)), ("extern", toJson ext)]
  return out

def run (root : Name) (endpoint : Name) (outPath : System.FilePath) : MetaM UInt32 := do
  let env ← getEnv
  let some ci := env.find? endpoint
    | IO.eprintln s!"endpoint {endpoint} not found after importing {root}"; return 3
  let cl := closure env #[endpoint]
  -- axioms in the closure
  let mut axioms : Array Json := #[]
  for n in cl.toList do
    if let some (.axiomInfo ai) := env.find? n then
      let m := moduleOf env n
      let mut fields : List (String × Json) := [
        ("name", toJson n.toString), ("module", toJson m),
        ("type_pp", toJson (← ppShort ai.type)), ("type_all", toJson (← ppAll ai.type)),
        ("is_unsafe", toJson ai.isUnsafe), ("range", ← rangeJson n)]
      match nativeParts? n with
      | some (decl, tac) =>
        -- the generated shape is `@Eq Bool e true`
        let shapeOk := ai.type.isAppOfArity ``Eq 3 &&
          ai.type.appFn!.appFn!.appArg! == mkConst ``Bool &&
          ai.type.appArg! == mkConst ``Bool.true
        let e := if ai.type.isAppOfArity ``Eq 3 then ai.type.appFn!.appArg! else ai.type
        let decided? : Option Expr :=
          if e.isAppOfArity ``Decidable.decide 2 then some e.appFn!.appArg! else none
        let declInfo := env.find? decl
        let declTypeAll ← match declInfo with
          | some dci => pure (some (← ppAll dci.type))
          | none => pure none
        let declModule := moduleOf env decl
        fields := fields ++ [
          ("native", Json.mkObj [
            ("tactic", toJson tac), ("decl", toJson decl.toString),
            ("decl_exists", toJson declInfo.isSome), ("decl_module", toJson declModule),
            ("decl_is_theorem", toJson (match declInfo with | some (.thmInfo _) => true | _ => false)),
            ("decl_type_all", toJson declTypeAll),
            ("decl_range", ← rangeJson decl),
            ("eq_true_shape", toJson shapeOk),
            ("has_fvar_or_mvar", toJson (e.hasFVar || e.hasMVar)),
            ("decided_prop_pp", toJson (← match decided? with
                | some p => do pure (some (← ppShort p)) | none => pure none)),
            ("decided_prop_all", toJson (← match decided? with
                | some p => do pure (some (← ppAll p)) | none => pure none)),
            ("implementations", Json.arr (implementations env #[e.getAppFn.constName?.getD Name.anonymous] ++
                (implementations env (e.getUsedConstants))))])]
      | none => pure ()
      axioms := axioms.push (Json.mkObj fields)
  -- project constants and string-literal sources
  let mut project : Array Json := #[]
  let mut strings : Array Json := #[]
  let dir := outPath.toString ++ ".strings"
  IO.FS.createDirAll dir
  for n in cl.toList do
    let m := moduleOf env n
    if isLibraryModule m then continue
    let some c := env.find? n | continue
    let kind := kindOf c
    let isUnsafe := c.isUnsafe
    let isPartial := c.isPartial
    let mentions : Array String := (c.type.getUsedConstants.filter fun k =>
        !isLibraryModule (moduleOf env k)).map Name.toString
    let valueMentions : Array String := match c with
      | .defnInfo d => (d.value.getUsedConstants.filter fun k =>
          !isLibraryModule (moduleOf env k)).map Name.toString
      | _ => #[]
    project := project.push <| Json.mkObj [("name", toJson n.toString), ("module", toJson m),
      ("kind", toJson kind), ("unsafe", toJson isUnsafe), ("partial", toJson isPartial),
      ("type_mentions", toJson mentions), ("value_mentions", toJson valueMentions),
      ("implemented_by", toJson ((Compiler.implementedByAttr.getParam? env n).map Name.toString)),
      ("extern", toJson (isExtern env n))]
    if let .defnInfo d := c then
      if let .lit (.strVal s) := d.value then
        let file := dir ++ "/" ++ n.toString ++ ".txt"
        IO.FS.writeFile file s
        strings := strings.push <| Json.mkObj [("name", toJson n.toString), ("module", toJson m),
          ("length", toJson s.length), ("file", toJson file)]
  -- which olean each project module was loaded from
  let mut mods : Array Json := #[]
  let mut seenMods : NameSet := {}
  for n in cl.toList do
    if let some idx := env.getModuleIdxFor? n then
      let mn := env.header.moduleNames[idx.toNat]!
      if seenMods.contains mn || isLibraryModule mn.toString then continue
      seenMods := seenMods.insert mn
      let olean ← (findOLean mn : IO System.FilePath)
      mods := mods.push <| Json.mkObj [("module", toJson mn.toString), ("olean", toJson olean.toString)]
  let out := Json.mkObj [
    ("schema", toJson "native-assisted-extract/1"),
    ("project_modules", Json.arr mods),
    ("lean_version", toJson Lean.versionString), ("lean_githash", toJson Lean.githash),
    ("root_module", toJson root.toString), ("endpoint", toJson endpoint.toString),
    ("endpoint_module", toJson (moduleOf env endpoint)),
    ("endpoint_kind", toJson (kindOf ci)),
    ("endpoint_type_pp", toJson (← ppShort ci.type)),
    ("endpoint_hypotheses", Json.arr (← forallTelescope ci.type fun xs _ => do
        let mut hs : Array Json := #[]
        for x in xs do
          let d ← x.fvarId!.getDecl
          hs := hs.push <| Json.mkObj [("binder", toJson d.userName.toString),
            ("type", toJson (← ppShort d.type))]
        return hs)),
    ("endpoint_type_all", toJson (← ppAll ci.type)),
    ("endpoint_type_canonical", toJson (← ppCanon ci.type)),
    ("closure_size", toJson cl.size),
    ("axioms", Json.arr axioms),
    ("project_constants", Json.arr project),
    ("string_literals", Json.arr strings)]
  IO.FS.writeFile outPath out.pretty
  return 0

end NativeAssisted

unsafe def main (args : List String) : IO UInt32 := do
  match args with
  | root :: endpoint :: out :: rest =>
    initSearchPath (← findSysroot)
    -- `Solution` is a module name in many solution packages; put the target package's own build
    -- directory first so the intended olean is imported, and record which one was.
    if let some libDir := rest.head? then
      searchPathRef.modify fun sp => (System.FilePath.mk libDir) :: sp
    enableInitializersExecution
    let rootName := root.toName
    let oleanPath ← findOLean rootName
    IO.FS.writeFile (out ++ ".root_olean") oleanPath.toString
    let env ← importModules #[{ module := rootName }] {} (trustLevel := 1024) (loadExts := true)
    let ctx : Core.Context := { fileName := "<native-assisted>", fileMap := default,
                                maxHeartbeats := 0 }
    let st : Core.State := { env }
    let (rc, _) ← ((NativeAssisted.run rootName endpoint.toName out).run' {} {}).toIO ctx st
    return rc
  | _ =>
    IO.eprintln "usage: Extract.lean <RootModule> <Endpoint> <out.json> [<package lib dir>]"
    return 2
